# 默认按文本处理，仓库内统一 LF
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle / shell 脚本保持 LF，避免容器与 CI 里执行失败
gradlew text eol=lf
*.sh text eol=lf

# 二进制资源不做行尾转换、不做差异展示
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
